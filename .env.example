# Chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Dùng từ giai đoạn 4 (bước lập kế hoạch gọi Claude API).
ANTHROPIC_API_KEY=
# Để trống = dùng model trong config/rules.json (ai.model, hiện là claude-sonnet-5-5).
# Chỉ điền khi máy này cần model khác, ví dụ: GANI_DV_CLAUDE_MODEL=claude-sonnet-5
GANI_DV_CLAUDE_MODEL=

# Hàng đợi dựng (giai đoạn 6). BẮT BUỘC nếu dùng `queue add`: các thư mục footage được phép
# đưa vào hàng đợi (thư mục con của chúng cũng được). Nhiều thư mục thì ngăn cách bằng ";"
# trên Windows, ":" trên Mac. Để trống = từ chối mọi job.
# Ví dụ Windows: GANI_DV_ALLOWED_ROOTS=E:\GANI BRAINSTORM
GANI_DV_ALLOWED_ROOTS=
# Nơi đặt queue.db và log của job. Để trống = thư mục jobs/ của dự án.
GANI_DV_QUEUE_DIR=
# Model Whisper cho giai đoạn `transcribe` của hàng đợi trên máy này. Để trống = dùng model
# trong config/rules.json (large-v3-turbo, chưa có trên máy Dell và nặng ~1,6GB khi tải lần đầu).
# Máy Dell: GANI_DV_WHISPER_MODEL=small
GANI_DV_WHISPER_MODEL=
# Thư mục thư viện nhạc trên máy này (bước `plan` của hàng đợi tìm bài nhạc ở đây khi tùy chọn
# nhạc là "thu_vien"). Để trống = bước plan chỉ tìm ở 2 nơi mặc định.
# Ví dụ Windows: GANI_DV_MUSIC_DIR=E:\GANI BRAINSTORM\Nhac test BPM
GANI_DV_MUSIC_DIR=
# CHỈ máy lập trình giao diện: các origin trình duyệt được tin gọi API ngoài chính máy chủ,
# ngăn cách bằng dấu phẩy. Để trống trên máy dựng. Khi chạy `npm run dev`:
# GANI_DV_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GANI_DV_DEV_ORIGINS=
